+// -- Cache probe traffic census ---------------------------------------------
+
+// A probe is a request, and a hit or a miss is its single answer. When the
+// answers outnumber the requests something between here and the offscreen
+// document is duplicating deliveries; when both climb together one of the
+// reasons below is looping. Reported as a rolling summary so diagnosing a storm
+// does not require reading thirty thousand identical lines.
+const PROBE_CENSUS_INTERVAL_MS = 15_000;
+const PROBE_CENSUS_FLOOR = 8;
+
+const probeReasonCounts = new Map<string, number>();
+let probesSent = 0;
+let probeAnswers = 0;
+let probeCensusStartedAt = Date.now();
+
+function countProbeTraffic(direction: "sent" | "answered", reason: string): void {
+  if (direction === "sent") {
+    probesSent++;
+    probeReasonCounts.set(reason, (probeReasonCounts.get(reason) ?? 0) + 1);
+  } else {
+    probeAnswers++;
+  }
+
+  const elapsedMs = Date.now() - probeCensusStartedAt;
+  if (elapsedMs < PROBE_CENSUS_INTERVAL_MS) return;
+
+  if (probesSent + probeAnswers >= PROBE_CENSUS_FLOOR) {
+    const reasons = [...probeReasonCounts.entries()]
+      .sort((a, b) => b[1] - a[1])
+      .map(([name, count]) => `${name}=${count}`)
+      .join(", ");
+    logger.warn(
+      `cache probe census over ${Math.round(elapsedMs / 1000)}s: ${probesSent} sent, ${probeAnswers} answered` +
+        `${probeAnswers > probesSent ? " (answers outnumber requests, deliveries are being duplicated)" : ""}` +
+        ` — sent by ${reasons}`
+    );
+  }
+
+  probeReasonCounts.clear();
+  probesSent = 0;
+  probeAnswers = 0;
+  probeCensusStartedAt = Date.now();
+}
