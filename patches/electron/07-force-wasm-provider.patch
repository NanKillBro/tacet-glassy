+// -- Execution provider override -------------------------------------------
+
+// The host that opens this document decides whether the inference runs on the
+// gpu, and it says so in the url it opens. A query parameter is the only channel
+// available before the first line of this script runs, which is what it has to
+// be: the choice has to be settled before a session is ever built.
+const forceWasm = new URLSearchParams(location.search).get("forceWasm") === "1";
